# Template de configuration - copier en .env et adapter
# cp .env.example .env
# Puis editer .env avec vos propres valeurs

# PostgreSQL
POSTGRES_DB=mlops_accidents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MLflow
# Port 5000 sur Windows (8080 souvent bloque)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=accidentologie-focus-tues
MLFLOW_REGISTRY_NAME=gravite-focus-tues
