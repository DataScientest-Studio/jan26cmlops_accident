# Template de configuration - copier en .env et adapter
# cp .env.example .env

# PostgreSQL (utilise par docker-compose + code Python)
POSTGRES_DB=mlops_accidents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# En mode Docker, utiliser le hostname du service :
# POSTGRES_HOST=db

# MLflow
MLFLOW_TRACKING_URI=http://localhost:8080
MLFLOW_EXPERIMENT=accidentologie-focus-tues
MLFLOW_REGISTRY_NAME=gravite-focus-tues

# Variables pour evidently, seuil année old/new dataset, seuil de réentrainement et nb maw de lignes pour analyse
MONITORING_SPLIT_YEAR=16
DRIFT_SHARE_THRESHOLD=0.3
MONITORING_MAX_ROWS=10000
